pipeline {
    agent any
    environment {
        IMAGE_NAME = 'nikhiy/vehicle-insurance:latest'  // Your Docker Hub repo
        DOCKER_HUB_CREDENTIALS = credentials('docker-hub-credentials')
    }
    stages {
        stage('Lint/Test') {
            agent {
                docker {
                    image 'python:3.10'
                    args '-u root'
                }
            }
            steps {
                sh 'pip install -r requirements.txt'
                sh 'pip install pylint pytest'
                sh 'pylint src/ || true'
                sh 'pytest src/ || true'
            }
        }
        stage('Build Docker') {
            steps {
                sh 'docker build -t $IMAGE_NAME .'
                sh 'docker tag $IMAGE_NAME $IMAGE_NAME'
            }
        }
        stage('Push') {
            steps {
                sh 'echo $DOCKER_HUB_CREDENTIALS_PSW | docker login -u $DOCKER_HUB_CREDENTIALS_USR --password-stdin'
                sh 'docker push $IMAGE_NAME'
            }
        }
        stage('Deploy') {
            when { branch 'main' }
            steps {
                sh 'docker stop vehicle-app || true'
                sh 'docker rm vehicle-app || true'
                sh 'docker run -d -p 5000:5000 --name vehicle-app -e MONGODB_URL=$MONGODB_URL $IMAGE_NAME'
            }
        }
    }
    post {
        always {
            sh 'docker logout || true'
        }
    }
}

